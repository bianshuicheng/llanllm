{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM被控端",
  "identifier": "com.llanllm.agent",
  "build": {
    "beforeDevCommand": "npm run dev:web:agent",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "LLM 被控端",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "perMachine"
      }
    }
  }
}
