{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM被控端",
  "version": "0.1.1",
  "identifier": "com.llanllm.agent",
  "build": {
    "beforeDevCommand": "npm run dev:web:agent",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM 被控端",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/runtime-agent/*": "runtime/"
    },    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
